# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env

# Tool caches and test outputs
.pytest_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/

# Local editor/OS files
.vscode/
.DS_Store

# Notebook checkpoints
.ipynb_checkpoints/

# Generated images are ignored by default,
# but example map outputs are tracked.
*.png
!examples/map_outputs/*.png
